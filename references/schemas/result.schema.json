{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QT run result",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "state", "data", "parameters", "metrics", "gates", "decision", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["start", "evo"]},
    "state": {"enum": ["COMPLETED", "REJECTED"]},
    "data": {
      "type": "object",
      "required": ["path", "sha256", "rows", "start", "end", "train_rows", "test_rows"]
    },
    "parameters": {
      "type": "object",
      "required": ["fast", "slow", "fee_bps"]
    },
    "metrics": {
      "type": "object",
      "required": ["train", "test"]
    },
    "gates": {"type": "array", "minItems": 6},
    "decision": {
      "type": "object",
      "required": ["accepted", "reasons", "baseline_modified"],
      "properties": {
        "accepted": {"type": "boolean"},
        "baseline_modified": {"const": false}
      }
    },
    "artifacts": {"type": "object"}
  }
}
